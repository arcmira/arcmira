{
  "name": "arcmira",
  "version": "0.4.3",
  "description": "YouTube transcript search with timestamps, mentions, sponsors and recommendations. Official Arcmira TypeScript SDK and CLI.",
  "license": "Apache-2.0",
  "author": "Arcmira",
  "homepage": "https://arcmira.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcmira/arcmira.git"
  },
  "bugs": {
    "url": "https://github.com/arcmira/arcmira/issues"
  },
  "keywords": [
    "arcmira",
    "sdk",
    "cli",
    "ai",
    "podcast monitoring",
    "transcript",
    "youtube monitoring",
    "mcp",
    "youtube-transcript-search",
    "transcript-search",
    "youtube-transcript",
    "typescript-sdk"
  ],
  "bin": {
    "arcmira": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "skills",
    "reference.md",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:cli",
    "build:cjs": "tsc --project ./tsconfig.cjs.json",
    "build:esm": "tsc --project ./tsconfig.esm.json && node scripts/rename-to-esm-files.js dist/esm",
    "build:cli": "tsc --project ./tsconfig.cli.json",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "prepack": "npm run build",
    "sync-skill": "node scripts/sync-skill.mjs",
    "generate": "bash scripts/generate.sh",
    "test:types": "tsc --noEmit --strict --skipLibCheck --target es2022 --module nodenext --moduleResolution nodenext tests/transcription-types.ts",
    "test:generation": "python3 -m unittest discover -s tests -p test_generation.py"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.ts",
